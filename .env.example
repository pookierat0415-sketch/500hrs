# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# The anon key is meant to be public; supabase/setup.sql limits it to inserting reports.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# AI polishing endpoint (server/ai-polish.php on your host). Leave empty to hide the feature.
VITE_AI_POLISH_URL=https://yourdomain.com/api/ai-polish.php

# Accounts and online backup endpoint (server/account.php). Leave empty to hide accounts.
VITE_ACCOUNT_API_URL=https://yourdomain.com/api/account.php
